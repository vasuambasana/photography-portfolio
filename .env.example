# Photography Portfolio: environment variables
# Copy to .env and fill in. Only needed for the ingest scripts; the site builds without it.

# Gemini API key for AI-generated photo titles, alt text and descriptions.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model the ingest scripts call, plus one fallback if the first is
# unavailable or rate-limited. Pinned so a model rename doesn't silently change output.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Where your original (unprocessed) photos live, organised into category subfolders:
#   <PHOTO_SOURCE_DIR>/architecture/, /nature/, /street/, /night/, /people/ ...
# Used by `npm run add-photo`, `npm run exif fix` and `npm run optimize`.
# This is machine-specific. Never commit your real path.
PHOTO_SOURCE_DIR=G:\My Drive\photography-portfolio

# Search engine ownership verification, read at build time.
#
# Preferred route is a DNS TXT record in Cloudflare, which verifies the whole
# domain and needs nothing here. Use these only if you verify by HTML meta tag
# instead. Set them in the Cloudflare Pages build environment, not just locally,
# or the tag will be missing from the deployed site.
#
# Google: Search Console > Add property > URL prefix > HTML tag. Paste the value
# from content="..." only, not the whole tag.
GOOGLE_SITE_VERIFICATION=

# Bing already has a committed token. Set this only to override it.
BING_SITE_VERIFICATION=
