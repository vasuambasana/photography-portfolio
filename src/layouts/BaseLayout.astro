---
import SEO from '../components/common/SEO.astro';
import Header from '../components/common/Header.astro';
import MobileMenu from '../components/common/MobileMenu.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  article?: {
    publishedTime?: string;
    section?: string;
  };
  noindex?: boolean;
}

const { title, description, ogImage, ogType, article, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.clarity.ms https://*.bing.com; worker-src 'self' blob:;" />

    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-DY8LMP98HR"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DY8LMP98HR');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/partytown">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y7hw76cv48");
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafafa" id="theme-color-meta" />

    <!-- Theme Initialization Script (blocking to prevent FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();
    
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.getElementById('theme-color-meta').setAttribute('content', '#fafafa');
      } else {
        document.documentElement.classList.add('dark');
        document.getElementById('theme-color-meta').setAttribute('content', '#09090b');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <!-- Preload critical fonts -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      article={article}
      noindex={noindex}
    />
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Skip to Content — first focusable element -->
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>

    <Header />
    <MobileMenu />

    <!-- Spacer for fixed header -->
    <div class="h-16 md:h-20" aria-hidden="true" />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Image Protection Script -->
    <script is:inline>
      document.addEventListener('contextmenu', function(e) {
        if (e.target.tagName === 'IMG') {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>
