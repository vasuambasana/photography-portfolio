---
import BaseLayout from './BaseLayout.astro';
import ThumbnailStrip from '../components/portfolio/ThumbnailStrip.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  date: string;
  coverImage?: string;
  currentSlug: string;
  allPhotosClient: Array<{ slug: string; title: string; imageSrc: string; alt: string; category: string }>;
}

const { title, description, category, date, coverImage, currentSlug, allPhotosClient } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={coverImage}
  article={{
    publishedTime: date,
    section: category,
  }}
>
  <article class="pb-section pt-4 md:pt-6">
    <slot />

    <!-- Filmstrip navigation -->
    <ThumbnailStrip currentSlug={currentSlug} allPhotosClient={allPhotosClient} />

    <!-- Contact CTA -->
    <div class="section-container mt-section text-center">
      <p class="text-text-secondary text-body-lg mb-6">
        Want to say hello?
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-3 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline"
      >
        Say Hello
      </a>
    </div>
  </article>
</BaseLayout>
