---
import BaseLayout from './BaseLayout.astro';
import ThumbnailStrip from '../components/portfolio/ThumbnailStrip.astro';

import type { Props as SEOProps } from '../components/common/SEO.astro';
import type { ClientPhoto } from '../pages/photo/[slug].astro';

export interface Props extends Pick<SEOProps, 'title' | 'description' | 'ogImageSize' | 'ogImageAlt' | 'breadcrumbs' | 'schemaProps'> {
  category: string;
  date: string;
  coverImage?: string;
  currentSlug: string;
  clientPhotos: ClientPhoto[];
}

const { category, date, coverImage, currentSlug, clientPhotos, ...seo } = Astro.props;
---

<BaseLayout
  {...seo}
  ogType="article"
  schema="Photograph"
  ogImage={coverImage}
  article={{
    publishedTime: date,
    section: category,
  }}
>
  <!-- Hold first paint until the photo exists, so a page transition can land on it. -->
  <Fragment slot="head" set:html={`<link rel="expect" href="#vt-photo" blocking="render">`} />

  <article class="pb-12 pt-2 md:pt-4">
    <slot />

    <!-- Filmstrip navigation -->
    <ThumbnailStrip currentSlug={currentSlug} clientPhotos={clientPhotos} />

    <!-- Contact CTA -->
    <div class="section-container mt-12 md:mt-16 text-center">
      <p class="text-text-secondary text-body-md mb-4">
        If this one reminds you of somewhere, I'd like to hear about it.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-7 py-2.5 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline"
      >
        Say Hello &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
