---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  date: string;
  coverImage?: string;
  prevProject?: { slug: string; title: string };
  nextProject?: { slug: string; title: string };
}

const { title, description, category, date, coverImage, prevProject, nextProject } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={coverImage}
  article={{
    publishedTime: date,
    section: category,
  }}
>
  <article class="py-section">
    <slot />

    <!-- Previous / Next navigation -->
    {(prevProject || nextProject) && (
      <nav
        class="section-container mt-section pt-8 border-t border-subtle"
        aria-label="Project navigation"
      >
        <div class="flex justify-between items-center gap-4">
          {prevProject ? (
            <a
              href={`/portfolio/${prevProject.slug}`}
              class="group flex flex-col gap-1 text-left no-underline"
            >
              <span class="meta-text">&larr; Previous</span>
              <span class="text-text-primary font-display text-lg group-hover:text-text-accent transition-colors">
                {prevProject.title}
              </span>
            </a>
          ) : <div />}

          {nextProject ? (
            <a
              href={`/portfolio/${nextProject.slug}`}
              class="group flex flex-col gap-1 text-right no-underline ml-auto"
            >
              <span class="meta-text">Next &rarr;</span>
              <span class="text-text-primary font-display text-lg group-hover:text-text-accent transition-colors">
                {nextProject.title}
              </span>
            </a>
          ) : <div />}
        </div>
      </nav>
    )}

    <!-- Contact CTA -->
    <div class="section-container mt-section text-center">
      <p class="text-text-secondary text-body-lg mb-6">
        Interested in working together?
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-3 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline"
      >
        Get in Touch
      </a>
    </div>
  </article>
</BaseLayout>
