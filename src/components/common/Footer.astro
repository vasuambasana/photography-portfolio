---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-subtle mt-section" role="contentinfo">
  <div class="section-container py-12 md:py-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Copyright -->
      <p class="text-text-secondary text-body-sm">
        &copy; {currentYear} Vasu Ambasana. All rights reserved.
      </p>

      <!-- Footer links -->
      <nav aria-label="Footer navigation">
        <ul class="flex items-center gap-6 text-body-sm">
          <li>
            <a
              href="/privacy"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Privacy
            </a>
          </li>
          <li>
            <a
              href="/accessibility"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Accessibility
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
