---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-subtle mt-section" role="contentinfo">
  <div class="section-container py-8 md:py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Copyright -->
      <p class="text-text-secondary text-body-sm">
        &copy; {currentYear} Vasu Ambasana. All rights reserved.
      </p>

      <!-- Footer links -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-body-sm">
          <li>
            <a
              href="https://instagram.com/vasu_ambasana"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Follow on Instagram
            </a>
          </li>
          <li>
            <a
              href="/labs"
              class="inline-flex items-center gap-1.5 text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6.5L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4a1.5 1.5 0 0 0 1.3-2.2L14 9.5V3"/><path d="M7 15h10"/></svg>
              Labs
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Privacy
            </a>
          </li>
          <li>
            <a
              href="/accessibility"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Accessibility
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
