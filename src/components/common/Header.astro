---
import Nav from './Nav.astro';
import MobileMenu from './MobileMenu.astro';
---

<header class="glass-nav fixed top-0 left-0 right-0 z-50">
  <div class="section-container flex items-center justify-between h-16 md:h-20">
    <!-- Site name / logo -->
    <a
      href="/"
      class="font-display text-lg md:text-xl font-semibold text-text-primary tracking-tight hover:opacity-80 transition-opacity no-underline"
      aria-label="Home"
    >
      <!-- [PLACEHOLDER: Replace with your name or logo] -->
      Portfolio
    </a>

    <!-- Desktop nav -->
    <Nav />

    <!-- Mobile menu -->
    <MobileMenu />
  </div>
</header>
