---
export interface Props {
  contactEmail?: string;
}

const { contactEmail = 'hello@example.com' } = Astro.props;
---

<form
  id="contact-form"
  action={`mailto:${contactEmail}`}
  method="POST"
  enctype="text/plain"
  class="space-y-6"
  novalidate
>
  <!-- Name -->
  <div>
    <label for="contact-name" class="block text-body-sm text-text-primary font-medium mb-2">
      Name <span class="text-text-secondary">*</span>
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      placeholder="Your full name"
      class="w-full px-4 py-3 bg-surface-card border border-subtle rounded-card text-text-primary text-body-md placeholder:text-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-text-accent focus:border-transparent transition-all duration-200"
    />
    <p id="contact-name-error" class="hidden mt-2 text-sm text-red-400" role="alert">
      Please enter your name.
    </p>
  </div>

  <!-- Email -->
  <div>
    <label for="contact-email" class="block text-body-sm text-text-primary font-medium mb-2">
      Email <span class="text-text-secondary">*</span>
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      placeholder="your@email.com"
      class="w-full px-4 py-3 bg-surface-card border border-subtle rounded-card text-text-primary text-body-md placeholder:text-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-text-accent focus:border-transparent transition-all duration-200"
    />
    <p id="contact-email-error" class="hidden mt-2 text-sm text-red-400" role="alert">
      Please enter a valid email address.
    </p>
  </div>

  <!-- Inquiry type -->
  <div>
    <label for="contact-type" class="block text-body-sm text-text-primary font-medium mb-2">
      Inquiry Type
    </label>
    <select
      id="contact-type"
      name="type"
      class="w-full px-4 py-3 bg-surface-card border border-subtle rounded-card text-text-primary text-body-md focus:outline-none focus:ring-2 focus:ring-text-accent focus:border-transparent transition-all duration-200 appearance-none"
    >
      <option value="general">General Inquiry</option>
      <option value="project">Project Collaboration</option>
      <option value="licensing">Image Licensing</option>
      <option value="other">Other</option>
    </select>
  </div>

  <!-- Message -->
  <div>
    <label for="contact-message" class="block text-body-sm text-text-primary font-medium mb-2">
      Message <span class="text-text-secondary">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows={6}
      placeholder="Tell me about your project or question..."
      class="w-full px-4 py-3 bg-surface-card border border-subtle rounded-card text-text-primary text-body-md placeholder:text-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-text-accent focus:border-transparent transition-all duration-200 resize-y min-h-[120px]"
    ></textarea>
    <p id="contact-message-error" class="hidden mt-2 text-sm text-red-400" role="alert">
      Please enter a message.
    </p>
  </div>

  <!-- Privacy notice -->
  <p class="text-caption text-text-secondary">
    By submitting this form, you agree to the
    <a href="/privacy" class="underline hover:text-text-primary">privacy policy</a>.
    Your information will only be used to respond to your inquiry.
  </p>

  <!-- Submit -->
  <button
    type="submit"
    class="inline-flex items-center gap-2 px-8 py-3.5 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 cursor-pointer"
  >
    Send Message
  </button>

  <!-- Status messages -->
  <div
    id="contact-status"
    class="hidden"
    aria-live="polite"
    role="status"
  ></div>
</form>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      let isValid = true;

      const name = form.querySelector<HTMLInputElement>('#contact-name');
      const email = form.querySelector<HTMLInputElement>('#contact-email');
      const message = form.querySelector<HTMLTextAreaElement>('#contact-message');

      // Reset errors
      document.querySelectorAll('[id$="-error"]').forEach((el) => el.classList.add('hidden'));

      // Validate name
      if (!name?.value.trim()) {
        document.getElementById('contact-name-error')?.classList.remove('hidden');
        isValid = false;
      }

      // Validate email
      if (!email?.value.trim() || !email.value.includes('@')) {
        document.getElementById('contact-email-error')?.classList.remove('hidden');
        isValid = false;
      }

      // Validate message
      if (!message?.value.trim()) {
        document.getElementById('contact-message-error')?.classList.remove('hidden');
        isValid = false;
      }

      if (!isValid) {
        e.preventDefault();
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
