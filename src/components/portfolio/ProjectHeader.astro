---
export interface Props {
  title: string;
  summary: string;
  category: string;
  date: Date;
  location: string;
  cameraSpecs?: {
    body: string;
    lenses?: string[];
  };
}

const { title, summary, category, date, location, cameraSpecs } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<header class="section-container py-section">
  <!-- Category & date -->
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest bg-surface-card border border-subtle rounded-full text-text-secondary">
      {category}
    </span>
    <span class="meta-text" aria-hidden="true">&middot;</span>
    <time datetime={date.toISOString()} class="meta-text">
      {formattedDate}
    </time>
    <span class="meta-text" aria-hidden="true">&middot;</span>
    <span class="meta-text">{location}</span>
  </div>

  <!-- Title -->
  <h1 class="font-display text-display-xl text-text-primary mb-6">
    {title}
  </h1>

  <!-- Summary -->
  <p class="text-body-lg text-text-secondary max-w-prose leading-relaxed">
    {summary}
  </p>

  <!-- Camera specs -->
  {cameraSpecs && (
    <div class="mt-8 pt-6 border-t border-subtle">
      <div class="flex flex-wrap items-center gap-4">
        <span class="meta-text">Shot on</span>
        <span class="text-body-sm text-text-primary font-mono">
          {cameraSpecs.body}
        </span>
        {cameraSpecs.lenses && cameraSpecs.lenses.length > 0 && (
          <>
            <span class="meta-text" aria-hidden="true">&middot;</span>
            {cameraSpecs.lenses.map((lens, i) => (
              <>
                <span class="text-body-sm text-text-secondary font-mono">{lens}</span>
                {i < (cameraSpecs.lenses?.length ?? 0) - 1 && (
                  <span class="text-text-secondary" aria-hidden="true">,</span>
                )}
              </>
            ))}
          </>
        )}
      </div>
    </div>
  )}
</header>
