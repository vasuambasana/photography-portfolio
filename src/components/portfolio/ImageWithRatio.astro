---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  aspectRatio?: '3:2' | '4:5' | '1:1' | '16:9' | '65:24';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  caption?: string;
}

const {
  src,
  alt,
  width,
  height,
  aspectRatio = '3:2',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  caption,
} = Astro.props;

const ratioMap: Record<string, string> = {
  '3:2': '3/2',
  '4:5': '4/5',
  '1:1': '1/1',
  '16:9': '16/9',
  '65:24': '65/24',
};

const cssRatio = ratioMap[aspectRatio] || '3/2';
---

<figure class:list={['image-with-ratio', className]}>
  <div
    class="overflow-hidden rounded-card bg-surface-card"
    style={`aspect-ratio: ${cssRatio};`}
  >
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="w-full h-full object-cover"
    />
  </div>
  {caption && (
    <figcaption class="mt-3 text-text-secondary text-body-sm font-body">
      {caption}
    </figcaption>
  )}
</figure>
