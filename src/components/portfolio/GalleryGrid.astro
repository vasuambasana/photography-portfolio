---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div id="portfolio-grid" class:list={[
  'columns-1 sm:columns-2 md:columns-3 lg:columns-4 2xl:columns-5 gap-3 md:gap-4 stagger-children [column-fill:_balance]',
  className,
]}>
  <slot />
</div>

