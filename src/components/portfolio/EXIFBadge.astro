---
export interface Props {
  focalLength?: string;
  aperture?: string;
  shutterSpeed?: string;
  iso?: string;
}

const { focalLength, aperture, shutterSpeed, iso } = Astro.props;

const specs = [
  focalLength && `${focalLength}`,
  aperture && `ƒ/${aperture}`,
  shutterSpeed && `${shutterSpeed}s`,
  iso && `ISO ${iso}`,
].filter(Boolean);

if (specs.length === 0) return;
---

<div class="flex flex-wrap items-center gap-2" aria-label="Camera settings">
  {specs.map((spec) => (
    <span class="inline-block px-2.5 py-1 bg-surface-card border border-subtle rounded text-xs font-mono text-text-secondary">
      {spec}
    </span>
  ))}
</div>
