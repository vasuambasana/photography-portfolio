---
import type { ClientPhoto } from '../../pages/photo/[slug].astro';

export interface Props {
  currentSlug: string;
  clientPhotos: ClientPhoto[];
}

const { currentSlug, clientPhotos } = Astro.props;
---

<div class="mt-16 border-t border-subtle pt-8 section-container">
  <div class="flex items-center justify-between mb-4">
    <h2 id="thumbnail-strip-heading" class="meta-text">More from gallery</h2>
    <p class="text-xs text-text-tertiary hidden sm:block">Use &larr; &rarr; keys to navigate</p>
  </div>

  <div class="relative w-full overflow-hidden">
    <!-- Filmstrip container -->
    <div
      class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory hide-scrollbar"
      id="thumbnail-strip"
    >
      {clientPhotos.map((photo) => {
        const isActive = photo.slug === currentSlug;
        return (
          <a
            href={`/photo/${photo.slug}`}
            class:list={[
              'thumbnail-link flex-none w-24 h-24 sm:w-32 sm:h-32 snap-center rounded-lg overflow-hidden transition-all duration-300',
              isActive ? 'ring-2 ring-text-accent scale-105 opacity-100' : 'opacity-50 hover:opacity-100',
            ]}
            aria-label={`View ${photo.title}`}
            aria-current={isActive ? 'page' : undefined}
            id={isActive ? 'active-thumbnail' : undefined}
            data-category={photo.category}
            data-base-href={`/photo/${photo.slug}`}
          >
            <img
              src={photo.thumb}
              alt={photo.alt}
              width="200"
              height="200"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  import { ALL_FILTER, getActiveFilter, matchesFilter, withFilter } from '../../utils/filter';

  const filter = getActiveFilter();

  const heading = document.getElementById('thumbnail-strip-heading');
  if (heading) {
    heading.textContent = filter === ALL_FILTER ? 'More from gallery' : 'More in this category';
  }

  document.querySelectorAll<HTMLAnchorElement>('.thumbnail-link').forEach((thumb) => {
    const shown = matchesFilter(thumb.dataset.category, filter);
    thumb.style.display = shown ? '' : 'none';
    if (shown && thumb.dataset.baseHref) {
      thumb.href = withFilter(thumb.dataset.baseHref, filter);
    }
  });

  // Centre the active thumbnail within the strip
  const activeThumb = document.getElementById('active-thumbnail');
  const strip = document.getElementById('thumbnail-strip');
  if (activeThumb && strip) {
    strip.scrollLeft = activeThumb.offsetLeft - strip.offsetWidth / 2 + activeThumb.offsetWidth / 2;
  }

  document.addEventListener('keydown', (e) => {
    // The lightbox owns the arrow keys while it is open.
    if (document.body.style.overflow === 'hidden') return;

    const id = e.key === 'ArrowLeft' ? 'prev-link' : e.key === 'ArrowRight' ? 'next-link' : null;
    if (!id) return;

    const link = document.getElementById(id) as HTMLAnchorElement | null;
    if (link && !link.classList.contains('hidden') && link.getAttribute('href') !== '#') {
      window.location.href = link.href;
    }
  });
</script>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
