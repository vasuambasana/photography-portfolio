---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Vasu Ambasana"
  description="About Vasu Ambasana and this personal photography archive - how the pictures get made, and what they get made on."
  schema="AboutPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]}
>
  <section class="py-section" aria-labelledby="about-heading">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-10">

        <!-- Portrait column -->
        <div class="lg:col-span-2">
          <div class="sticky top-28">
            <div
              class="w-full rounded-card bg-surface-card border border-subtle flex items-center justify-center text-text-secondary text-body-sm overflow-hidden"
              style="aspect-ratio: 4/5;"
            >
              <img
                src="/profile-photo.jpg"
                alt="Portrait of photographer Vasu Ambasana"
                width="1200"
                height="1799"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>
        </div>

        <!-- Bio column -->
        <div class="lg:col-span-3">
          <p class="meta-text mb-6">About</p>

          <h1 id="about-heading" class="font-display text-display-xl text-text-primary mb-8">
            Vasu Ambasana
          </h1>

          <div class="space-y-6 text-body-lg text-text-secondary leading-relaxed">
            <p>
              This is a personal archive, not a business. It's where I keep the photographs I
              want to look at again - a few hundred frames, gathered slowly, with no particular
              plan beyond paying attention.
            </p>

            <p>
              Mostly that means architecture and geometry, quiet coastlines, the night sky, and
              the occasional stranger who made a frame worth taking. Natural light, minimal
              editing. If a photograph made it here, it's because I still liked it months later.
            </p>

            <p>
              Some of it was shot on a Canon. Rather more of it was shot on whatever phone
              happened to be in my pocket at the time, which I've stopped being embarrassed
              about - every photograph on this site lists the camera that took it, and the
              cheapest gear here produced some of the frames I like most.
            </p>
          </div>

          <!-- Equipment & Process -->
          <div class="mt-8 pt-8 border-t border-subtle">
            <h2 class="font-display text-display-md text-text-primary mb-6">
              Equipment & Process
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <h3 class="meta-text mb-3">Cameras</h3>
                <p class="text-text-secondary text-body-sm">
                  A Canon R5 Mark II, and whatever phone is in my pocket
                </p>
              </div>
              <div>
                <h3 class="meta-text mb-3">Approach</h3>
                <p class="text-text-secondary text-body-sm">
                  Natural light, minimal post-processing, slow selection
                </p>
              </div>
              <div>
                <h3 class="meta-text mb-3">Subjects</h3>
                <p class="text-text-secondary text-body-sm">
                  Architecture, landscape, street, night sky, people
                </p>
              </div>
            </div>
          </div>

          <!-- CTA -->
          <div class="mt-8 pt-8 border-t border-subtle">
              <p class="text-text-secondary text-body-lg mb-6">
                Want to say hello or follow my latest work?
              </p>
              <div class="flex flex-wrap items-center gap-4">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline"
                >
                  Say Hello
                </a>
                <a
                  href="https://instagram.com/vasu_ambasana"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-8 py-3 border border-subtle bg-transparent text-text-primary font-body font-medium text-sm rounded-full hover:bg-surface-elevated hover:border-text-accent transition-all duration-300 no-underline"
                >
                  Follow on Instagram
                </a>
              </div>
            </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
