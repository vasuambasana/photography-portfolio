---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ClickableImage from '../../components/portfolio/ClickableImage';

export async function getStaticPaths() {
  const photos = await getCollection('photos');

  return photos.map((photo) => {
    // Get all photos in the same category
    const categoryPhotos = photos
      .filter((p) => p.data.category === photo.data.category)
      .sort((a, b) => a.data.order - b.data.order)
      .map(p => ({
        slug: p.slug,
        title: p.data.title,
        imageSrc: typeof p.data.image === 'string' ? p.data.image : p.data.image.src,
        alt: p.data.alt
      }));

    const allSorted = [...photos].sort((a, b) => a.data.order - b.data.order);
    
    // Map all sorted photos for the client
    const allPhotosClient = allSorted.map(p => ({
      slug: p.slug,
      title: p.data.title,
      imageSrc: typeof p.data.image === 'string' ? p.data.image : p.data.image.src,
      alt: p.data.alt,
      category: p.data.category
    }));

    // Find prev/next for ALL photos
    const allIdx = allSorted.findIndex(p => p.slug === photo.slug);
    const prevPhotoAll = allIdx > 0 ? allSorted[allIdx - 1] : null;
    const nextPhotoAll = allIdx < allSorted.length - 1 ? allSorted[allIdx + 1] : null;

    // Find prev/next for CATEGORY photos
    const catIdx = categoryPhotos.findIndex(p => p.slug === photo.slug);
    const prevPhotoCat = catIdx > 0 ? categoryPhotos[catIdx - 1] : null;
    const nextPhotoCat = catIdx < categoryPhotos.length - 1 ? categoryPhotos[catIdx + 1] : null;

    return {
      params: { slug: photo.slug },
      props: {
        photo,
        allPhotosClient,
        prevPhotoAll: prevPhotoAll ? { slug: prevPhotoAll.slug, title: prevPhotoAll.data.title } : null,
        nextPhotoAll: nextPhotoAll ? { slug: nextPhotoAll.slug, title: nextPhotoAll.data.title } : null,
        prevPhotoCat: prevPhotoCat ? { slug: prevPhotoCat.slug, title: prevPhotoCat.title } : null,
        nextPhotoCat: nextPhotoCat ? { slug: nextPhotoCat.slug, title: nextPhotoCat.title } : null,
      },
    };
  });
}

interface Props {
  photo: CollectionEntry<'photos'>;
  allPhotosClient: Array<{ slug: string; title: string; imageSrc: string; alt: string; category: string }>;
  prevPhotoAll: { slug: string; title: string } | null;
  nextPhotoAll: { slug: string; title: string } | null;
  prevPhotoCat: { slug: string; title: string } | null;
  nextPhotoCat: { slug: string; title: string } | null;
}

const { photo, allPhotosClient, prevPhotoAll, nextPhotoAll, prevPhotoCat, nextPhotoCat } = Astro.props;
const { Content } = await photo.render();
const { title, category, date, image, alt, location, cameraSpecs } = photo.data;

const imageSrc = typeof image === 'string' ? image : image.src;

const galleryImages = allPhotosClient.map((p: any) => ({
  src: p.imageSrc,
  alt: p.alt,
  caption: p.title,
  slug: p.slug,
  category: p.category
}));
const initialIndex = allPhotosClient.findIndex((p: any) => p.slug === photo.slug);
---

<PhotoLayout
  title={title}
  description={title}
  category={category}
  date={date.toISOString()}
  coverImage={imageSrc}
  currentSlug={photo.slug}
  allPhotosClient={allPhotosClient}
>
  <div class="section-container">
    <!-- Immersive Exhibition Theater Display -->
    <div class="relative rounded-2xl overflow-hidden bg-zinc-950 border border-white/10 shadow-2xl flex items-center justify-center p-2 sm:p-4 md:p-6">
      <ClickableImage 
        client:load
        src={imageSrc}
        alt={alt}
        caption={title}
        galleryImages={galleryImages}
        initialIndex={initialIndex}
        className="w-full h-auto max-h-[82vh] object-contain mx-auto rounded-lg"
      />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="flex items-center justify-between py-4" aria-label="Photo navigation">
      <a
        id="prev-link"
        href={prevPhotoCat ? `/photo/${prevPhotoCat.slug}` : "#"}
        data-all-href={prevPhotoAll ? `/photo/${prevPhotoAll.slug}` : ""}
        data-cat-href={prevPhotoCat ? `/photo/${prevPhotoCat.slug}` : ""}
        class={`inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline ${!prevPhotoCat ? 'hidden' : ''}`}
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4l-6 6 6 6" /></svg>
        Previous
      </a>
      
      <a
        href="/gallery"
        class="text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline mx-auto"
      >
        All Photos
      </a>
      
      <a
        id="next-link"
        href={nextPhotoCat ? `/photo/${nextPhotoCat.slug}` : "#"}
        data-all-href={nextPhotoAll ? `/photo/${nextPhotoAll.slug}` : ""}
        data-cat-href={nextPhotoCat ? `/photo/${nextPhotoCat.slug}` : ""}
        class={`inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline ${!nextPhotoCat ? 'hidden' : ''}`}
      >
        Next
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4l6 6-6 6" /></svg>
      </a>
    </nav>

    <!-- Metadata and Content: Balanced 2-Column Spread on Desktop -->
    <div class="mt-8 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left: Story & Narrative -->
        <div class="lg:col-span-7 space-y-6">
          <header>
            <h1 class="text-display-md font-display text-text-primary mb-3">{title}</h1>
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono tracking-wider text-text-secondary uppercase">
              <span class="px-2.5 py-0.5 rounded-full border border-subtle bg-surface-overlay">{category}</span>
              {location && (
                <span class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-overlay">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {location}
                </span>
              )}
              <span class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-overlay">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </header>

          <!-- The markdown content / photographer's notes: Standard clean body font -->
          <div class="prose prose-invert prose-zinc max-w-none text-text-secondary text-body-md font-body leading-relaxed [&>p]:mb-4">
            <Content />
          </div>
        </div>

        <!-- Right: Technical Details Plaque -->
        {cameraSpecs && (
          <div class="lg:col-span-5 bg-surface-card border border-subtle rounded-2xl p-6 shadow-sm">
            <div class="flex items-center gap-2 mb-5 pb-3 border-b border-subtle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-secondary">
                <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-text-secondary">Technical Specs</h3>
            </div>
            
            <div class="grid grid-cols-2 gap-4 text-sm">
              {cameraSpecs.body && (
                <div class="col-span-2 sm:col-span-1">
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Camera Body</span>
                  <span class="text-text-primary font-body text-sm font-medium">{cameraSpecs.body}</span>
                </div>
              )}
              {cameraSpecs.lens && (
                <div class="col-span-2 sm:col-span-1">
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Lens</span>
                  <span class="text-text-primary font-body text-sm font-medium">{cameraSpecs.lens}</span>
                </div>
              )}
              {cameraSpecs.focalLength && (
                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Focal Length</span>
                  <span class="text-text-primary font-mono text-sm">{cameraSpecs.focalLength}</span>
                </div>
              )}
              {cameraSpecs.aperture && (
                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Aperture</span>
                  <span class="text-text-primary font-mono text-sm">{cameraSpecs.aperture}</span>
                </div>
              )}
              {cameraSpecs.shutterSpeed && (
                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Shutter Speed</span>
                  <span class="text-text-primary font-mono text-sm">{cameraSpecs.shutterSpeed}</span>
                </div>
              )}
              {cameraSpecs.iso && (
                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">ISO</span>
                  <span class="text-text-primary font-mono text-sm">{cameraSpecs.iso}</span>
                </div>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-subtle flex items-center justify-between">
              <a href="/gallery" class="text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline">
                &larr; Back to Gallery
              </a>
              <a href="/contact" class="text-xs font-mono uppercase tracking-wider text-text-accent hover:opacity-80 transition-opacity no-underline">
                Inquire &rarr;
              </a>
            </div>
          </div>
        )}

      </div>
    </div>
  </div>
</PhotoLayout>

<script>
  // Astro module scripts are deferred, so DOM is ready when this runs.
  // No View Transitions in this project, so astro:page-load never fires.
  (function initPrevNextLinks() {
    const params = new URLSearchParams(window.location.search);
    // Default to 'all' when no filter is specified (e.g. from home page)
    const filter = params.get('filter') || 'all';
    
    const prevLink = document.getElementById('prev-link');
    const nextLink = document.getElementById('next-link');

    if (prevLink) {
      const href = (filter === 'all') ? prevLink.dataset.allHref : prevLink.dataset.catHref;
      if (href) {
        prevLink.href = href + '?filter=' + filter;
        prevLink.classList.remove('hidden');
      } else {
        prevLink.classList.add('hidden');
      }
    }

    if (nextLink) {
      const href = (filter === 'all') ? nextLink.dataset.allHref : nextLink.dataset.catHref;
      if (href) {
        nextLink.href = href + '?filter=' + filter;
        nextLink.classList.remove('hidden');
      } else {
        nextLink.classList.add('hidden');
      }
    }
  })();
</script>
