---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ClickableImage from '../../components/portfolio/ClickableImage';

export async function getStaticPaths() {
  const photos = await getCollection('photos');

  return photos.map((photo) => {
    // Get all photos in the same category
    const categoryPhotos = photos
      .filter((p) => p.data.category === photo.data.category)
      .sort((a, b) => a.data.order - b.data.order)
      .map(p => ({
        slug: p.slug,
        title: p.data.title,
        imageSrc: typeof p.data.image === 'string' ? p.data.image : p.data.image.src,
        alt: p.data.alt
      }));

    // Find prev/next across ALL photos (not just category)
    const allSorted = [...photos].sort((a, b) => a.data.order - b.data.order);
    const currentIdx = allSorted.findIndex(p => p.slug === photo.slug);
    const prevPhoto = currentIdx > 0 ? allSorted[currentIdx - 1] : null;
    const nextPhoto = currentIdx < allSorted.length - 1 ? allSorted[currentIdx + 1] : null;

    return {
      params: { slug: photo.slug },
      props: {
        photo,
        categoryPhotos,
        prevPhoto: prevPhoto ? { slug: prevPhoto.slug, title: prevPhoto.data.title } : null,
        nextPhoto: nextPhoto ? { slug: nextPhoto.slug, title: nextPhoto.data.title } : null,
      },
    };
  });
}

interface Props {
  photo: CollectionEntry<'photos'>;
  categoryPhotos: Array<{ slug: string; title: string; imageSrc: string; alt: string }>;
  prevPhoto: { slug: string; title: string } | null;
  nextPhoto: { slug: string; title: string } | null;
}

const { photo, categoryPhotos, prevPhoto, nextPhoto } = Astro.props;
const { Content } = await photo.render();
const { title, category, date, image, alt, location, cameraSpecs } = photo.data;

const imageSrc = typeof image === 'string' ? image : image.src;

const galleryImages = categoryPhotos.map((p: any) => ({
  src: p.imageSrc,
  alt: p.alt,
  caption: p.title,
  slug: p.slug
}));
const initialIndex = categoryPhotos.findIndex((p: any) => p.slug === photo.slug);
---

<PhotoLayout
  title={title}
  description={title}
  category={category}
  date={date.toISOString()}
  coverImage={imageSrc}
  currentSlug={photo.slug}
  categoryPhotos={categoryPhotos}
>
  <div class="section-container">
    <!-- Full-width Photo Display -->
    <div class="rounded-xl overflow-hidden bg-surface-overlay shadow-sm">
      <ClickableImage 
        client:load
        src={imageSrc}
        alt={alt}
        caption={title}
        galleryImages={galleryImages}
        initialIndex={initialIndex}
        className="w-full h-auto max-h-[85vh] object-contain mx-auto bg-surface-main"
      />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="flex items-center justify-between py-4" aria-label="Photo navigation">
      {prevPhoto ? (
        <a
          href={`/photo/${prevPhoto.slug}`}
          class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline"
        >
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4l-6 6 6 6" /></svg>
          Previous
        </a>
      ) : <span />}
      <a
        href="/portfolio"
        class="text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline"
      >
        All Photos
      </a>
      {nextPhoto ? (
        <a
          href={`/photo/${nextPhoto.slug}`}
          class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline"
        >
          Next
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4l6 6-6 6" /></svg>
        </a>
      ) : <span />}
    </nav>

    <!-- Metadata and Content -->
    <div class="max-w-prose mx-auto mt-4">
      <header class="mb-6">
        <h1 class="text-display-md font-display text-text-primary mb-2">{title}</h1>
        <div class="flex flex-wrap gap-4 text-xs font-mono tracking-wider text-text-secondary uppercase">
          <span>{category}</span>
          {location && (
            <>
              <span class="text-subtle">&bull;</span>
              <span>{location}</span>
            </>
          )}
        </div>
      </header>

      <!-- The markdown content (few sentences) -->
      <div class="prose prose-invert prose-zinc max-w-none text-text-secondary text-body-md leading-relaxed [&>p]:mb-4">
        <Content />
      </div>

      <!-- Camera Specs -->
      {cameraSpecs && (
        <div class="mt-6 pt-6 border-t border-subtle">
          <h3 class="text-xs font-mono uppercase tracking-widest text-text-secondary mb-4">Gear & Settings</h3>
          <ul class="grid grid-cols-2 md:grid-cols-3 gap-y-3 gap-x-6 text-sm text-text-secondary">
            {cameraSpecs.body && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">Camera</span>
                <span class="text-text-primary">{cameraSpecs.body}</span>
              </li>
            )}
            {cameraSpecs.lens && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">Lens</span>
                <span class="text-text-primary">{cameraSpecs.lens}</span>
              </li>
            )}
            {cameraSpecs.focalLength && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">Focal Length</span>
                <span class="text-text-primary">{cameraSpecs.focalLength}</span>
              </li>
            )}
            {cameraSpecs.aperture && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">Aperture</span>
                <span class="text-text-primary">{cameraSpecs.aperture}</span>
              </li>
            )}
            {cameraSpecs.shutterSpeed && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">Shutter</span>
                <span class="text-text-primary">{cameraSpecs.shutterSpeed}</span>
              </li>
            )}
            {cameraSpecs.iso && (
              <li>
                <span class="block text-xs uppercase text-text-tertiary mb-1">ISO</span>
                <span class="text-text-primary">{cameraSpecs.iso}</span>
              </li>
            )}
          </ul>
        </div>
      )}
    </div>
  </div>
</PhotoLayout>
