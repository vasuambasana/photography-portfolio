---
import { getImage } from 'astro:assets';
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ClickableImage from '../../components/portfolio/ClickableImage';
import { neighbours, photosInCategory, sortPhotos } from '../../utils/photos';
import { exifData, metaDescription } from '../../utils/seo';
import { Image } from 'astro:assets';
import { cameraName } from '../../utils/camera';
import { developDuration } from '../../utils/exposure';
import { getArchive } from '../../data/archive';
import type { PhotoFacts } from '../../data/archive';
import { tintedSurface } from '../../utils/palette';
import { journalMentions, publishedJournal, sortJournal } from '../../utils/journal';
import type { JournalMention } from '../../utils/journal';
import { JOURNAL_TYPE_LABELS } from '../../content/config';

export async function getStaticPaths() {
  const photos = sortPhotos(await getCollection('photos'));

  // Built once for the whole route. Every photo page shares the same filmstrip
  // and lightbox payload, so the image transforms must not run per page.
  const clientPhotos = await Promise.all(
    photos.map(async (p) => ({
      slug: p.slug,
      title: p.data.title,
      alt: p.data.alt,
      category: p.data.category,
      src: (await getImage({ src: p.data.image, width: 1800, format: 'webp' })).src,
      thumb: (await getImage({ src: p.data.image, width: 200, format: 'webp' })).src,
    }))
  );

  // Links only ever ran journal -> photo. This is the way back, also built once.
  const mentions = journalMentions(sortJournal(publishedJournal(await getCollection('journal'))));

  // Labs: measured palettes and each photograph's colour rhyme, computed once.
  const archive = await getArchive();
  const bySlug = new Map<string, CollectionEntry<'photos'>>(photos.map((p) => [p.slug, p]));

  return photos.map((photo) => {
    const all = neighbours(photos, photo.slug);
    const cat = neighbours(photosInCategory(photos, photo.data.category), photo.slug);

    const summarise = (p: CollectionEntry<'photos'> | null) =>
      p ? { slug: p.slug, title: p.data.title } : null;

    return {
      params: { slug: photo.slug },
      props: {
        photo,
        clientPhotos,
        writtenAbout: mentions.get(photo.slug) ?? [],
        prevPhotoAll: summarise(all.prev),
        nextPhotoAll: summarise(all.next),
        prevPhotoCat: summarise(cat.prev),
        nextPhotoCat: summarise(cat.next),
        facts: archive.facts.get(photo.slug) ?? null,
        rhyme: (() => {
          const other = bySlug.get(archive.rhymes.get(photo.slug) ?? '');
          const otherFacts = other && archive.facts.get(other.slug);
          return other && otherFacts ? { photo: other, palette: otherFacts.palette } : null;
        })(),
      },
    };
  });
}

export interface ClientPhoto {
  slug: string;
  title: string;
  alt: string;
  category: string;
  src: string;
  thumb: string;
}

interface Props {
  photo: CollectionEntry<'photos'>;
  clientPhotos: ClientPhoto[];
  writtenAbout: JournalMention[];
  prevPhotoAll: { slug: string; title: string } | null;
  nextPhotoAll: { slug: string; title: string } | null;
  prevPhotoCat: { slug: string; title: string } | null;
  nextPhotoCat: { slug: string; title: string } | null;
  facts: PhotoFacts | null;
  rhyme: { photo: CollectionEntry<'photos'>; palette: { hex: string; weight: number }[] } | null;
}

const { photo, clientPhotos, writtenAbout, prevPhotoAll, nextPhotoAll, prevPhotoCat, nextPhotoCat, facts, rhyme } = Astro.props;
const { Content } = await photo.render();
const { title, category, date, image, alt, location, cameraSpecs } = photo.data;

const camera = cameraName(cameraSpecs?.body);
const develop = developDuration(cameraSpecs?.shutterSpeed);
const specs = cameraSpecs ?? {};
const hasSpecs = Boolean(camera || specs.lens || specs.focalLength || specs.aperture || specs.shutterSpeed || specs.iso);

const display = await getImage({ src: image, width: 1800, format: 'webp' });

// The page photo comes in the size the screen needs, not always the 1800px original: a
// phone was downloading up to 2MB per photo, and waiting on it. It is shown no wider than
// the column and no taller than 82vh, so its width is also capped by its own shape.
const smaller = await Promise.all([800, 1200].map((width) => getImage({ src: image, width, format: 'webp' })));
const displaySrcset = [...smaller.map((v, i) => `${v.src} ${[800, 1200][i]}w`), `${display.src} 1800w`].join(', ');
const displaySizes = `min(100vw, ${Math.round(82 * (image.width / image.height))}vh)`;
const initialIndex = clientPhotos.findIndex((p) => p.slug === photo.slug);
const ambient = clientPhotos[initialIndex]?.thumb ?? display.src;

// WebP still trips up some crawlers (LinkedIn, WhatsApp), which then show no card
// at all. Social previews get their own JPEG at the size the platforms expect.
const social = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const description = metaDescription(photo.body, alt);

const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const palette = (facts?.palette ?? []).map((s) => ({ hex: s.hex, weight: Number(s.weight.toFixed(3)) }));
// Everything the Labs scripts need, from the file and the measurements, nothing else.
const photoFacts = JSON.stringify({
  slug: photo.slug,
  title,
  date: dateLabel,
  isoDate: date.toISOString().slice(0, 10),
  location: location || null,
  camera,
  focal: specs.focalLength?.replace(/\s*\(35mm eq\)/, '').replace(/\.0mm$/, 'mm') ?? null,
  aperture: specs.aperture ?? null,
  shutter: specs.shutterSpeed ?? null,
  iso: specs.iso ?? null,
  ev: facts?.ev ?? null,
  full: display.src,
  palette,
}).replace(/</g, '\\u003c');

// Labs: the two palettes side by side under the colour rhyme, as measured.
const rhymeRows = rhyme
  ? [
      { label: 'This', colours: palette },
      { label: 'Rhyme', colours: rhyme.palette.map((c) => ({ hex: c.hex, weight: c.weight })) },
    ]
  : [];

// Labs: the page takes its colour from the photograph. The accent is the photograph's
// own most vivid colour, already made readable in both themes (utils/palette.ts), and
// the background leans towards it only as far as the body text allows.
const accent = facts?.accent;
const rgb = (c: number[]) => c.join(' ');
const accentCss = accent
  ? `html.labs{--color-text-accent:${rgb(accent.light)};` +
    `--color-surface-main:${rgb(tintedSurface([250, 250, 250], accent.light, [113, 113, 122], 0.04))};` +
    `--selection-bg:rgba(${accent.light.join(',')},.22)}` +
    `html.labs.dark{--color-text-accent:${rgb(accent.dark)};` +
    `--color-surface-main:${rgb(tintedSurface([9, 9, 11], accent.dark, [161, 161, 170], 0.08))};` +
    `--selection-bg:rgba(${accent.dark.join(',')},.3)}`
  : '';
---

<PhotoLayout
  title={title}
  description={description}
  category={category}
  date={date.toISOString()}
  coverImage={social.src}
  ogImageSize={{ width: 1200, height: 630 }}
  ogImageAlt={alt}
  currentSlug={photo.slug}
  clientPhotos={clientPhotos}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Gallery', path: '/gallery' },
    { name: title, path: `/photo/${photo.slug}` },
  ]}
  schemaProps={{
    '@type': 'Photograph',
    contentUrl: new URL(display.src, Astro.site).toString(),
    thumbnailUrl: new URL(social.src, Astro.site).toString(),
    width: display.attributes.width,
    height: display.attributes.height,
    dateCreated: date.toISOString(),
    caption: alt,
    keywords: [category, ...(location ? [location] : [])],
    copyrightHolder: { '@type': 'Person', name: 'Vasu Ambasana' },
    copyrightNotice: `© ${date.getUTCFullYear()} Vasu Ambasana`,
    creditText: 'Vasu Ambasana',
    ...(location ? { contentLocation: { '@type': 'Place', name: location } } : {}),
    ...(exifData(cameraSpecs).length ? { exifData: exifData(cameraSpecs) } : {}),
  }}
>
  {accentCss && <Fragment slot="head" set:html={`<style>${accentCss}</style>`} />}
  <div class="section-container photo-stage">
    <!-- Immersive Exhibition Theater Display -->
    <div class="photo-theatre relative rounded-2xl overflow-hidden bg-black border border-white/10 shadow-2xl flex items-center justify-center p-2 sm:p-4 md:p-6">
      <!-- Ambient light: the photograph itself, blurred far past recognition, so the frame
           around a portrait is tinted by its own colour instead of flat black. -->
      <img src={ambient} alt="" aria-hidden="true" class="photo-ambient" width="200" height="200" />
      <div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>
      <ClickableImage
        client:load
        src={display.src}
        srcSet={displaySrcset}
        sizes={displaySizes}
        width={display.attributes.width}
        height={display.attributes.height}
        alt={alt}
        caption={title}
        galleryImages={clientPhotos}
        initialIndex={initialIndex}
        id="vt-photo"
        developMs={develop}
        className="relative w-full h-auto max-h-[82vh] object-contain mx-auto rounded-lg"
      />
    </div>
    <!-- Lights down: the rest of the page dims while the photograph fills the screen. -->
    <div class="lights-down" aria-hidden="true"></div>

    <!-- Prev / Next navigation -->
    <nav class="flex items-center justify-between py-4" aria-label="Photo navigation">
      <a
        id="prev-link"
        href={prevPhotoCat ? `/photo/${prevPhotoCat.slug}` : '#'}
        data-all-href={prevPhotoAll ? `/photo/${prevPhotoAll.slug}` : ''}
        data-cat-href={prevPhotoCat ? `/photo/${prevPhotoCat.slug}` : ''}
        class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline hidden"
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4l-6 6 6 6" /></svg>
        Previous
      </a>

      <a
        href="/gallery"
        class="text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline mx-auto"
      >
        All Photos
      </a>

      <a
        id="next-link"
        href={nextPhotoCat ? `/photo/${nextPhotoCat.slug}` : '#'}
        data-all-href={nextPhotoAll ? `/photo/${nextPhotoAll.slug}` : ''}
        data-cat-href={nextPhotoCat ? `/photo/${nextPhotoCat.slug}` : ''}
        class="inline-flex items-center gap-2 text-text-secondary hover:text-text-primary text-body-sm font-mono uppercase tracking-wider transition-colors no-underline hidden"
      >
        Next
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4l6 6-6 6" /></svg>
      </a>
    </nav>

    <!-- Labs: tools for looking at the photograph. -->
    <div class="labs-only flex flex-wrap items-center justify-center gap-2 pb-2 text-body-sm">
      <button type="button" data-viewfinder aria-pressed="false" class="labs-tool">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8V5a2 2 0 012-2h3M16 3h3a2 2 0 012 2v3M21 16v3a2 2 0 01-2 2h-3M8 21H5a2 2 0 01-2-2v-3"/><rect x="9" y="9" width="6" height="6"/></svg>
        Viewfinder <kbd class="hidden sm:inline font-mono text-[10px] opacity-60">V</kbd>
      </button>
      <button type="button" data-card-open="card" class="labs-tool">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><rect x="7" y="6" width="10" height="8"/><path d="M7 17h10"/></svg>
        Settings card
      </button>
      <button type="button" data-card-open="postcard" class="labs-tool">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="1.5"/><path d="M12 8v8"/><rect x="15" y="8" width="4" height="4"/><path d="M4.5 10h5M4.5 13h5"/></svg>
        Postcard
      </button>
      <span class="text-text-secondary text-caption px-2">Press and hold the photograph to look closer</span>
    </div>

    <!-- Metadata and Content: Balanced 2-Column Spread on Desktop -->
    <div class="mt-8 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- Left: Story & Narrative -->
        <div class="lg:col-span-7 space-y-6">
          <header>
            <h1 class="text-display-md font-display text-text-primary mb-3">{title}</h1>
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono tracking-wider text-text-secondary uppercase">
              <a href={`/gallery?filter=${category}`} class="px-2.5 py-0.5 rounded-full border border-subtle bg-surface-overlay no-underline hover:text-text-primary transition-colors">{category}</a>
              {location && (
                <span class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-overlay">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {location}
                </span>
              )}
              <span class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-overlay">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
          </header>

          <!-- The markdown content / photographer's notes -->
          <div class="max-w-none text-text-secondary text-body-md font-body leading-relaxed [&>p]:mb-4 [&>p:last-child]:mb-0">
            <Content />
          </div>

          {writtenAbout.length > 0 && (
            <section aria-labelledby="journal-mentions-heading" class="pt-6 border-t border-subtle">
              <h2 id="journal-mentions-heading" class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-secondary mb-3">
                In the journal
              </h2>
              <ul class="space-y-3">
                {writtenAbout.map((m) => (
                  <li>
                    <a href={`/journal/${m.slug}`} class="group block no-underline">
                      <span class="block font-display text-body-lg text-text-primary group-hover:text-text-accent transition-colors duration-300">
                        {m.title}
                      </span>
                      <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary mt-0.5">
                        {JOURNAL_TYPE_LABELS[m.type]} &middot; {m.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {rhyme && (
            <section aria-labelledby="rhyme-heading" class="labs-only pt-6 border-t border-subtle">
              <h2 id="rhyme-heading" class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-secondary mb-3">
                Colour rhyme
              </h2>
              <a href={`/photo/${rhyme.photo.slug}`} class="group flex items-center gap-4 no-underline">
                <Image
                  src={rhyme.photo.data.image}
                  alt={rhyme.photo.data.alt}
                  width={240}
                  widths={[120, 240]}
                  sizes="120px"
                  class="w-[120px] h-auto max-h-[120px] object-contain rounded-md bg-surface-overlay"
                />
                <span class="min-w-0">
                  <span class="block font-display text-body-lg text-text-primary group-hover:text-text-accent transition-colors duration-300">
                    {rhyme.photo.data.title}
                  </span>
                  <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary mt-0.5">
                    {rhyme.photo.data.date.getUTCFullYear()} &middot; the same colours, another day
                  </span>
                  <span class="mt-3 grid grid-cols-[auto_1fr] items-center gap-x-2 gap-y-1.5 w-full max-w-[16rem]" aria-hidden="true">
                    {rhymeRows.map((row) => (
                      <>
                        <span class="text-[9px] font-mono uppercase tracking-[0.15em] text-text-secondary">{row.label}</span>
                        <span class="palette-chips">
                          {row.colours.map((c) => <span style={`--chip:${c.hex};flex-grow:${c.weight}`}></span>)}
                        </span>
                      </>
                    ))}
                  </span>
                </span>
              </a>
            </section>
          )}
        </div>

        <!-- Right: Technical Details Plaque -->
        <div class="lg:col-span-5 bg-surface-card border border-subtle rounded-2xl p-6 shadow-sm">
          <div class="flex items-center gap-2 mb-5 pb-3 border-b border-subtle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-secondary">
              <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-text-secondary">Technical Specs</h2>
          </div>

          {!hasSpecs && (
            <p class="text-body-sm text-text-secondary">
              This file carries no camera settings, so none are shown. Nothing here is guessed.
            </p>
          )}

          <div class="grid grid-cols-2 gap-4 text-sm">
            {camera && (
              <div class="col-span-2 sm:col-span-1">
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Camera Body</span>
                <span class="text-text-primary font-body text-sm font-medium">{camera}</span>
              </div>
            )}
            {specs.lens && (
              <div class="col-span-2 sm:col-span-1">
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Lens</span>
                <span class="text-text-primary font-body text-sm font-medium">{specs.lens}</span>
              </div>
            )}
            {specs.focalLength && (
              <div>
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Focal Length</span>
                <span class="text-text-primary font-mono text-sm">{specs.focalLength}</span>
              </div>
            )}
            {specs.aperture && (
              <div>
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Aperture</span>
                <span class="text-text-primary font-mono text-sm">{specs.aperture}</span>
              </div>
            )}
            {specs.shutterSpeed && (
              <div>
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">Shutter Speed</span>
                <span class="text-text-primary font-mono text-sm">{specs.shutterSpeed}</span>
              </div>
            )}
            {specs.iso && (
              <div>
                <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary/70 mb-0.5">ISO</span>
                <span class="text-text-primary font-mono text-sm">{specs.iso}</span>
              </div>
            )}
          </div>

          <div class="mt-6 pt-4 border-t border-subtle flex items-center justify-between">
            <a href="/gallery" class="text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline">
              &larr; Back to Gallery
            </a>
            <a href="/contact" class="text-xs font-mono uppercase tracking-wider text-text-accent hover:opacity-80 transition-opacity no-underline">
              Say Hello &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <dialog id="card-dialog" aria-label={`Cards of ${title}`} class="card-dialog rounded-2xl border border-subtle bg-surface-card text-text-primary p-4 sm:p-6 max-w-[min(92vw,520px)] w-full">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div role="tablist" aria-label="Kind of card" class="inline-flex rounded-full border border-subtle p-1 gap-1">
        <button type="button" role="tab" data-card-mode="card" aria-selected="true" class="card-tab">Settings card</button>
        <button type="button" role="tab" data-card-mode="postcard" aria-selected="false" class="card-tab">Postcard</button>
      </div>
      <form method="dialog"><button class="labs-tool">Close</button></form>
    </div>
    <div data-card-panel="card">
      <img alt={`Settings card for ${title}`} class="w-full h-auto rounded-lg border border-subtle" />
    </div>
    <div data-card-panel="postcard" hidden>
      <div class="postcard" data-postcard role="button" tabindex="0" aria-label="Turn the postcard over">
        <div class="postcard-inner">
          <canvas class="postcard-face postcard-front" aria-label={`Postcard front: ${alt}`}></canvas>
          <canvas class="postcard-face postcard-back" aria-label="Postcard back"></canvas>
        </div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
        <div role="group" aria-label="Side of the postcard" class="inline-flex rounded-full border border-subtle p-1 gap-1">
          <button type="button" data-postcard-side="front" aria-pressed="true" class="card-tab">Front</button>
          <button type="button" data-postcard-side="back" aria-pressed="false" class="card-tab">Back</button>
        </div>
        <p class="text-caption text-text-secondary">Or tap the card to turn it over.</p>
      </div>
      <label class="block mt-3">
        <span class="block text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary mb-1">Write on the back</span>
        <textarea data-postcard-message maxlength="180" rows="3" class="postcard-message" placeholder="Wish you were here."></textarea>
      </label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-2 justify-end">
      <button type="button" data-card-share class="labs-tool" hidden>Share</button>
      <a data-card-save class="labs-tool no-underline">Save image</a>
    </div>
  </dialog>
  <script type="application/json" id="photo-facts" set:html={photoFacts} />
</PhotoLayout>

<script>
  import { ALL_FILTER, getActiveFilter, withFilter } from '../../utils/filter';
  import { onSwipe } from '../../scripts/swipe';
  import { labsOn } from '../../scripts/labs';
  import { attachLoupe, loupeEngaged } from '../../scripts/loupe';
  import { attachViewfinder, readFacts } from '../../scripts/viewfinder';
  import { attachCards } from '../../scripts/card-dialog';
  import { markSeen } from '../../scripts/seen';

  const filter = getActiveFilter();

  for (const id of ['prev-link', 'next-link']) {
    const link = document.getElementById(id) as HTMLAnchorElement | null;
    if (!link) continue;

    const target = filter === ALL_FILTER ? link.dataset.allHref : link.dataset.catHref;
    if (target) {
      link.href = withFilter(target, filter);
      link.classList.remove('hidden');
    } else {
      link.classList.add('hidden');
    }
  }

  // On touch screens, swipe the photograph itself to step to the next or previous one,
  // in the same order as the links above (which already respect the gallery filter).
  const theatre = document.querySelector<HTMLElement>('.photo-theatre');
  const follow = (id: string) => {
    const link = document.getElementById(id) as HTMLAnchorElement | null;
    if (link && !link.classList.contains('hidden') && link.getAttribute('href') !== '#') link.click();
  };
  if (theatre) {
    onSwipe(theatre, {
      left: () => follow('next-link'),
      right: () => follow('prev-link'),
      enabled: () => !loupeEngaged(),
    });
  }

  // Labs.
  const facts = readFacts();
  const img = document.getElementById('vt-photo') as HTMLImageElement | null;
  if (labsOn() && facts && img) {
    markSeen(facts.slug);
    attachLoupe(img, facts.full);
    attachViewfinder(img, facts, [...document.querySelectorAll<HTMLButtonElement>('[data-viewfinder]')]);
    const dialog = document.getElementById('card-dialog') as HTMLDialogElement | null;
    if (dialog) attachCards(facts, dialog, [...document.querySelectorAll<HTMLButtonElement>('[data-card-open]')]);
  }
</script>
