---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photos');
const featuredPhotos = allPhotos
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);

const allJournal = await getCollection('journal');
const latestJournal = allJournal
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const typeLabels: Record<string, string> = {
  'field-notes': 'Field Notes',
  'location-guide': 'Location Guide',
  'essay': 'Essay',
  'behind-the-lens': 'Behind the Lens',
};
---

<BaseLayout
  title="Vasu Ambasana"
  description="The photography portfolio of Vasu Ambasana, showcasing architectural, landscape, editorial, and documentary work."
>
  <!-- Hero Section -->
  <section class="relative flex items-center justify-center pt-8 pb-10 md:pt-12 md:pb-14" aria-labelledby="hero-heading">
    <div class="relative section-container text-center fade-in">
      <p class="meta-text mb-3">Vasu Ambasana &mdash; Photography</p>

      <h1 id="hero-heading" class="font-display text-display-md md:text-display-lg text-text-primary mb-6 max-w-3xl mx-auto">
        Seeing the world through light, geometry, and quiet moments
      </h1>

      <p class="text-body-md text-text-secondary max-w-xl mx-auto mb-6">
        A curated collection of architectural, landscape, and editorial photography by Vasu Ambasana - exploring the interplay of structure, nature, and human presence.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/gallery"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline"
        >
          View Gallery
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-8 py-3.5 border border-subtle text-text-primary font-body font-medium text-sm rounded-full hover:bg-surface-overlay transition-colors duration-300 no-underline"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Photos -->
  {featuredPhotos.length > 0 && (
    <section class="pt-4 pb-8 md:pt-6 md:pb-12" aria-labelledby="featured-heading">
      <div class="section-container">
        <div class="flex items-center justify-between mb-4">
          <h2 id="featured-heading" class="font-display text-display-md text-text-primary">
            Featured Work
          </h2>
          <a
            href="/gallery"
            class="meta-text hover:text-text-primary transition-colors no-underline"
          >
            View All &rarr;
          </a>
        </div>

        <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-3 md:gap-4 stagger-children">
          {featuredPhotos.map((photo) => (
            <div class="group relative overflow-hidden rounded-card bg-surface-overlay mb-3 md:mb-4 break-inside-avoid">
              <a href={`/photo/${photo.slug}`} class="block w-full">
                <img
                  src={typeof photo.data.image === 'string' ? photo.data.image : photo.data.image.src}
                  alt={photo.data.alt}
                  loading="lazy"
                  class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
                  <span class="p-4 text-white text-sm font-body font-medium">{photo.data.title}</span>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Journal Teaser -->
  {latestJournal.length > 0 && (
    <section class="py-10 md:py-16 border-t border-subtle" aria-labelledby="journal-heading">
      <div class="section-container">
        <div class="flex items-center justify-between mb-8">
          <h2 id="journal-heading" class="font-display text-display-md text-text-primary">
            From the Journal
          </h2>
          <a
            href="/journal"
            class="meta-text hover:text-text-primary transition-colors no-underline"
          >
            Read All &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {latestJournal.map((entry) => (
            <article class="group">
              <a href={`/journal/${entry.slug}`} class="block">
                <div class="relative overflow-hidden rounded-xl mb-4 aspect-[16/9]">
                  <img
                    src={entry.data.coverImage}
                    alt={entry.data.coverAlt}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                  <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.15em] bg-white/10 backdrop-blur-md text-white rounded-full border border-white/20">
                    {typeLabels[entry.data.type] || entry.data.type}
                  </span>
                </div>

                <div class="space-y-2">
                  <div class="flex items-center gap-3 text-xs font-mono tracking-wider text-text-secondary uppercase">
                    {entry.data.location && <span>{entry.data.location}</span>}
                    <span>{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</span>
                    {entry.data.readingTime && <span>{entry.data.readingTime} min</span>}
                  </div>
                  <h3 class="text-xl font-display font-semibold text-text-primary group-hover:text-text-accent transition-colors duration-200">
                    {entry.data.title}
                  </h3>
                  <p class="text-text-secondary text-body-md leading-relaxed line-clamp-2">
                    {entry.data.excerpt}
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- About teaser -->
  <section class="py-8 md:py-12 border-t border-subtle" aria-labelledby="about-teaser-heading">
    <div class="prose-container text-center">
      <h2 id="about-teaser-heading" class="font-display text-display-md text-text-primary mb-4">
        About
      </h2>
      <p class="text-body-md text-text-secondary mb-6">
        Every photograph is an act of attention. I work with natural light and deliberate composition to reveal the quiet beauty in architectural form, open landscapes, and human expression.
      </p>
      <a
        href="/about"
        class="inline-flex items-center gap-2 text-text-accent text-body-sm font-medium hover:opacity-80 transition-opacity"
      >
        Learn More &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

