---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/portfolio/PhotoCard.astro';
import JournalCard from '../components/journal/JournalCard.astro';
import { getCollection } from 'astro:content';
import { sortPhotos } from '../utils/photos';
import { decorate, publishedJournal, sortJournal } from '../utils/journal';

const allPhotos = await getCollection('photos');
const featuredPhotos = sortPhotos(allPhotos.filter((p) => p.data.featured)).slice(0, 12);

const heroPhoto = allPhotos.find((p) => p.slug === 'twilight-over-manhattan') ?? sortPhotos(allPhotos)[0];

const latestJournal = await decorate(sortJournal(publishedJournal(await getCollection('journal'))).slice(0, 2));
---

<BaseLayout
  title="Vasu Ambasana — Photography"
  description="Fine-art architecture, street, and nature photography by Vasu Ambasana. Exploring structure, geometry, and natural light."
>
  <!-- Immersive Cinematic Hero -->
  <section class="relative px-3 sm:px-4 md:px-6 pt-2 pb-6 md:pb-8" aria-labelledby="hero-heading">
    <div class="relative w-full min-h-[72vh] md:min-h-[80vh] rounded-3xl overflow-hidden flex flex-col justify-between p-6 sm:p-8 md:p-14 shadow-2xl border border-white/10">
      
      <!-- Hero Background Photography -->
      <Image
        src={heroPhoto.data.image}
        alt={heroPhoto.data.alt}
        width={2400}
        widths={[800, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center transform scale-105 transition-transform duration-1000 ease-out"
      />
      
      <!-- Multi-layer Atmospheric Gradients for pristine contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/60 backdrop-blur-[0.5px]" />
      <div class="absolute inset-0 bg-radial-gradient from-transparent via-black/20 to-black/80" />

      <!-- Top Tagline & Pill -->
      <div class="relative z-10 flex items-center justify-between">
        <span class="px-3.5 py-1.5 rounded-full text-[11px] font-mono tracking-[0.2em] uppercase text-white/90 bg-white/10 backdrop-blur-md border border-white/20">
          Fine Art &middot; Architecture &middot; Nature
        </span>
        <span class="hidden sm:inline-flex items-center gap-2 text-xs font-mono text-white/70 tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          NEW YORK / BOSTON
        </span>
      </div>

      <!-- Hero Main Content -->
      <div class="relative z-10 max-w-3xl space-y-4 my-auto py-8">
        <h1 id="hero-heading" class="font-display text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-semibold text-white tracking-tight leading-[1.1]">
          Seeing the world through light, geometry, and quiet moments.
        </h1>
        <p class="text-white/80 text-sm sm:text-base md:text-lg font-body max-w-xl leading-relaxed">
          A visual archive of urban forms, quiet coastlines, and human narratives by Vasu Ambasana.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="/gallery"
            class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 bg-white text-zinc-950 font-body font-medium text-sm rounded-full hover:bg-white/90 transition-all duration-300 shadow-lg no-underline"
          >
            <span>Explore Gallery</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="/journal"
            class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 bg-white/15 hover:bg-white/25 text-white font-body font-medium text-sm rounded-full backdrop-blur-md border border-white/25 transition-all duration-300 no-underline"
          >
            Read Journal
          </a>
        </div>
      </div>

      <!-- Bottom Hero Plaque / Meta -->
      <div class="relative z-10 pt-4 border-t border-white/15 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-white/75">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Featured: {heroPhoto.data.title}{heroPhoto.data.location && `, ${heroPhoto.data.location}`}</span>
        </div>
        <div class="flex items-center gap-4 text-white/60 text-[11px]">
          <span>{allPhotos.length} WORKS</span>
          <span>&bull;</span>
          <span>LOCATION GUIDES</span>
          <span>&bull;</span>
          <span>EXIF ARCHIVE</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Featured Work (Seamless Masonry Showcase) -->
  {featuredPhotos.length > 0 && (
    <section class="py-8 md:py-12" aria-labelledby="featured-heading">
      <div class="section-container">
        
        <!-- Section Header -->
        <div class="flex items-end justify-between mb-6 pb-4 border-b border-subtle">
          <div>
            <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-text-secondary block mb-1">Curated Selection</span>
            <h2 id="featured-heading" class="font-display text-2xl md:text-3xl font-semibold text-text-primary">
              Featured Work
            </h2>
          </div>
          <a
            href="/gallery"
            class="group inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline"
          >
            <span>View All Gallery</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Masonry Grid with natural aspect ratios -->
        <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-3 md:gap-4 stagger-children">
          {featuredPhotos.map((photo) => (
            <PhotoCard
              photo={photo}
              rounded="rounded-2xl"
              class="shadow-sm hover:shadow-xl transition-all duration-500"
              showCategory
              showLocation
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- From the Journal -->
  {latestJournal.length > 0 && (
    <section class="py-10 md:py-14 bg-surface-overlay/40 border-y border-subtle" aria-labelledby="journal-heading">
      <div class="section-container">
        
        <div class="flex items-end justify-between mb-8 pb-3 border-b border-subtle">
          <div>
            <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-text-secondary block mb-1">Field Notes &amp; Stories</span>
            <h2 id="journal-heading" class="font-display text-2xl md:text-3xl font-semibold text-text-primary">
              From the Journal
            </h2>
          </div>
          <a
            href="/journal"
            class="group inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline"
          >
            <span>Explore All Stories</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {latestJournal.map(({ entry, cover, minutes }) => (
            <JournalCard entry={entry} cover={cover} minutes={minutes} variant="card" aspect="16/9" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Editorial About Statement -->
  <section class="py-12 md:py-16" aria-labelledby="about-teaser-heading">
    <div class="section-container">
      <div class="bg-surface-card border border-subtle rounded-3xl p-8 sm:p-10 md:p-14 flex flex-col md:flex-row items-center justify-between gap-8 shadow-sm">
        <div class="max-w-xl space-y-3">
          <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-text-secondary block">The Perspective</span>
          <h2 id="about-teaser-heading" class="font-display text-2xl md:text-4xl font-semibold text-text-primary">
            Every photograph is an act of deliberate attention.
          </h2>
          <p class="text-text-secondary text-body-md font-body leading-relaxed">
            Working with natural light and geometric composition to reveal quiet beauty across architecture, expansive horizons, and spontaneous human moments.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
          <a
            href="/about"
            class="px-7 py-3 bg-text-primary text-surface-main font-body font-medium text-sm rounded-full hover:bg-text-accent transition-colors duration-300 no-underline text-center"
          >
            About Vasu &rarr;
          </a>
          <a
            href="/contact"
            class="px-7 py-3 border border-subtle text-text-primary font-body font-medium text-sm rounded-full hover:bg-surface-overlay transition-colors duration-300 no-underline text-center"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>


