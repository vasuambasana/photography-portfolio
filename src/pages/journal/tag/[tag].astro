---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JournalCard from '../../../components/journal/JournalCard.astro';
import { getCollection } from 'astro:content';
import { collectTags, decorate, publishedJournal, sortJournal, tagSlug } from '../../../utils/journal';

export async function getStaticPaths() {
  const entries = publishedJournal(await getCollection('journal'));

  return [...collectTags(entries).entries()].map(([slug, { tag, entries: tagged }]) => ({
    params: { tag: slug },
    props: { tag, entries: sortJournal(tagged) },
  }));
}

const { tag, entries } = Astro.props;
const decorated = await decorate(entries);

// Most tags carry a single entry, so the page is a near-duplicate of that entry
// with none of its substance. Keep it crawlable for the links, out of the index
// for the thin content; a tag earns indexing once it collects a few entries.
const MIN_ENTRIES_TO_INDEX = 2;
---

<BaseLayout
  title={`${tag} — Journal`}
  description={`${entries.length} journal ${entries.length === 1 ? 'entry' : 'entries'} tagged ${tag} - field notes and location guides by Vasu Ambasana.`}
  noindex={entries.length < MIN_ENTRIES_TO_INDEX}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
    { name: `#${tag}`, path: `/journal/tag/${tagSlug(tag)}` },
  ]}
>
  <section class="section-container pt-4 pb-16">
    <header class="mb-8 md:mb-10 max-w-2xl">
      <a href="/journal" class="text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline">
        &larr; All Journal
      </a>
      <div class="flex items-center gap-3 mt-3 mb-2">
        <h1 class="text-display-lg font-display text-text-primary">#{tag}</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-surface-overlay text-text-secondary border border-subtle">
          {decorated.length} {decorated.length === 1 ? 'Story' : 'Stories'}
        </span>
      </div>
    </header>

    <div class="space-y-8 md:space-y-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {decorated.map(({ entry, cover, minutes }, index) => (
        <JournalCard
          entry={entry}
          cover={cover}
          minutes={minutes}
          loading={index < 3 ? 'eager' : 'lazy'}
          showSubtitle
        />
      ))}
    </div>
  </section>
</BaseLayout>
