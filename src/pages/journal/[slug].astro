---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCard from '../../components/portfolio/PhotoCard.astro';
import { getCollection, getEntry, getEntries } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { JOURNAL_TYPE_LABELS } from '../../content/config';
import { publishedJournal, readingTime, sortJournal, tagSlug } from '../../utils/journal';
import { neighbours } from '../../utils/photos';
import { developDuration } from '../../utils/exposure';
import { specLine } from '../../utils/camera';

export async function getStaticPaths() {
  const entries = publishedJournal(await getCollection('journal'));
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, subtitle, type, date, coverImage, location, tags, relatedPhotos } = entry.data;

const cover = (await getEntry(coverImage))!;
const related = await getEntries(relatedPhotos);
const minutes = readingTime(entry.body);
const coverDevelop = developDuration(cover.data.cameraSpecs?.shutterSpeed);

// Hover previews for the photographs this entry links to in its prose. Only the ones it
// actually names, so each page carries a handful of small thumbnails, not the archive.
const linkedSlugs = [...new Set([...entry.body.matchAll(/\/photo\/([a-z0-9-]+)/g)].map((m) => m[1]))];
const previews = Object.fromEntries(
  (
    await Promise.all(
      linkedSlugs.map(async (slug) => {
        const photo = await getEntry('photos', slug);
        if (!photo) return null;
        const img = await getImage({ src: photo.data.image, width: 480, format: 'webp' });
        return [
          slug,
          {
            title: photo.data.title,
            src: img.src,
            width: img.attributes.width,
            height: img.attributes.height,
            specs: specLine(photo.data.cameraSpecs),
            date: photo.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' }),
          },
        ] as const;
      })
    )
  ).filter((p) => p !== null)
);
// JSON inside a script tag: `<` is escaped so no title can ever close the tag early.
const previewJson = JSON.stringify(previews).replace(/</g, '\\u003c');

// Social scrapers want a modest JPEG, not the full-size original.
const ogImage = await getImage({ src: cover.data.image, width: 1200, format: 'jpeg' });

const allEntries = sortJournal(publishedJournal(await getCollection('journal')));
// The list runs newest-first, so the previous *entry* is the next one along.
const { prev: newerEntry, next: olderEntry } = neighbours(allEntries, entry.slug);
---

<BaseLayout
  title={title}
  description={entry.data.excerpt}
  ogImage={ogImage.src}
  ogImageSize={{ width: ogImage.attributes.width, height: ogImage.attributes.height }}
  ogImageAlt={cover.data.alt}
  ogType="article"
  schema="BlogPosting"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
    { name: title, path: `/journal/${entry.slug}` },
  ]}
  schemaProps={{
    dateModified: date.toISOString(),
    wordCount: entry.body.split(/\s+/).filter(Boolean).length,
    keywords: tags,
    inLanguage: 'en-US',
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/journal/${entry.slug}`, Astro.site).toString() },
    ...(location ? { contentLocation: { '@type': 'Place', name: location } } : {}),
  }}
  article={{
    publishedTime: date.toISOString(),
    section: JOURNAL_TYPE_LABELS[type],
    readingTime: minutes,
  }}
>
  <!-- Hold first paint until the photo exists, so a page transition can land on it. -->
  <Fragment slot="head" set:html={`<link rel="expect" href="#vt-photo" blocking="render">`} />

  <!-- Hero cover image -->
  <div class="relative w-full h-[40vh] md:h-[55vh] overflow-hidden">
    <Image
      src={cover.data.image}
      alt={cover.data.alt}
      width={2400}
      widths={[800, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      id="vt-photo"
      data-develop
      style={`--develop:${coverDevelop}ms`}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface-main via-surface-main/30 to-transparent" />
  </div>

  <article class="section-container -mt-20 relative z-10">
    <!-- Article header -->
    <header class="max-w-prose mx-auto mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-xs font-mono tracking-wider text-text-secondary uppercase">
        <span class="px-2.5 py-1 rounded-full border border-subtle">
          {JOURNAL_TYPE_LABELS[type]}
        </span>
        {location && (
          <span class="flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {location}
          </span>
        )}
        <span>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        <span>{minutes} min read</span>
      </div>

      <h1 class="text-display-lg font-display text-text-primary mb-3">{title}</h1>
      {subtitle && (
        <p class="text-body-lg text-text-secondary italic font-display">{subtitle}</p>
      )}
    </header>

    <!-- Article body -->
    <div class="max-w-prose mx-auto journal-body">
      <Content />
    </div>
    <script type="application/json" id="photo-previews" set:html={previewJson} />

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="max-w-prose mx-auto mt-10 pt-8 border-t border-subtle">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/journal/tag/${tagSlug(tag)}`}
              class="px-3 py-1 text-xs font-mono uppercase tracking-wider text-text-secondary bg-surface-overlay rounded-full no-underline hover:text-text-primary transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Related Photos -->
    {related.length > 0 && (
      <div class="max-w-4xl mx-auto mt-14">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-text-secondary mb-6 flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
          Related Photos
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {related.map((photo) => (
            <PhotoCard
              photo={photo}
              aspect="4/3"
              rounded="rounded-lg"
              class="mb-0"
              widths={[300, 600]}
              sizes="(min-width: 768px) 30vw, 45vw"
            />
          ))}
        </div>
      </div>
    )}

    <!-- Prev / Next navigation -->
    <nav class="max-w-prose mx-auto mt-14 pt-8 border-t border-subtle">
      <div class="flex justify-between items-center gap-4">
        {olderEntry ? (
          <a href={`/journal/${olderEntry.slug}`} class="group flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-hover:-translate-x-1">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <div>
              <span class="block text-[10px] font-mono uppercase tracking-wider text-text-secondary/60">Older</span>
              <span class="text-sm font-body">{olderEntry.data.title}</span>
            </div>
          </a>
        ) : <div />}
        {newerEntry ? (
          <a href={`/journal/${newerEntry.slug}`} class="group flex items-center gap-2 text-right text-text-secondary hover:text-text-primary transition-colors no-underline">
            <div>
              <span class="block text-[10px] font-mono uppercase tracking-wider text-text-secondary/60">Newer</span>
              <span class="text-sm font-body">{newerEntry.data.title}</span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ) : <div />}
      </div>
    </nav>
  </article>

  <script>
    import '../../scripts/photo-preview';
  </script>

  <!-- Bottom spacer -->
  <div class="h-16 md:h-24" aria-hidden="true" />
</BaseLayout>
