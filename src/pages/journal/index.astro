---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalCard from '../../components/journal/JournalCard.astro';
import { getCollection } from 'astro:content';
import { collectTags, decorate, publishedJournal, sortJournal } from '../../utils/journal';

const allEntries = publishedJournal(await getCollection('journal'));
const entries = await decorate(sortJournal(allEntries));
const tags = [...collectTags(allEntries).entries()].sort((a, b) => b[1].entries.length - a[1].entries.length);
---

<BaseLayout
  title="Journal"
  description="Stories from the field — location guides, photographer's notes, and visual essays by Vasu Ambasana."
  ogType="website"
>
  <section class="section-container pt-4 pb-16">
    <!-- Header -->
    <header class="mb-8 md:mb-10 max-w-2xl">
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-display-lg font-display text-text-primary">Journal</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-surface-overlay text-text-secondary border border-subtle">
          {entries.length} {entries.length === 1 ? 'Story' : 'Stories'}
        </span>
      </div>
      <p class="text-body-md text-text-secondary leading-relaxed">
        Stories from the field — location guides, technical notes, and the narratives behind the images.
      </p>
      <p class="mt-3">
        <a href="/journal/rss.xml" class="text-xs font-mono uppercase tracking-wider text-text-secondary hover:text-text-primary transition-colors no-underline">
          Subscribe via RSS
        </a>
      </p>
    </header>

    {tags.length > 0 && (
      <nav aria-label="Filter journal by tag" class="mb-8 flex flex-wrap gap-2">
        <button
          data-tag="all"
          class="tag-btn px-3 py-1 text-[11px] font-mono uppercase tracking-wider rounded-full border border-subtle text-text-secondary hover:text-text-primary transition-colors"
          aria-pressed="false"
        >
          All <span class="text-text-secondary/60">{entries.length}</span>
        </button>
        {tags.map(([slug, { tag, entries: tagged }]) => (
          <button
            data-tag={slug}
            class="tag-btn px-3 py-1 text-[11px] font-mono uppercase tracking-wider rounded-full border border-subtle text-text-secondary hover:text-text-primary transition-colors"
            aria-pressed="false"
          >
            {tag} <span class="text-text-secondary/60">{tagged.length}</span>
          </button>
        ))}
      </nav>
    )}

    <!-- Journal entries -->
    {entries.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-text-secondary text-body-lg">Coming soon — stories are being written.</p>
      </div>
    ) : (
      <div class="space-y-8 md:space-y-0 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-8">
        {entries.map(({ entry, cover, minutes }, index) => {
          const lead = index === 0 && entries.length > 1;
          return (
            <JournalCard
              entry={entry}
              cover={cover}
              minutes={minutes}
              aspect={lead ? '21/9' : '16/10'}
              prominent={lead}
              class={lead ? 'md:col-span-2' : ''}
              loading={index < 3 ? 'eager' : 'lazy'}
              showSubtitle
              showTags
            />
          );
        })}
      </div>
    )}

    <p id="journal-empty" class="hidden text-center py-16 text-text-secondary text-body-md">
      No stories with that tag yet.
    </p>
  </section>

  <script>
    import { ALL_FILTER, getActiveFilter } from '../../utils/filter';

    // Filtering happens in place rather than navigating to /journal/tag/<slug>. With a
    // small journal, a tag page holding one story is a dead end; the tag pages still
    // exist as shareable permalinks, linked from inside each entry.
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const cards = document.querySelectorAll<HTMLElement>('[data-tags]');
    const empty = document.getElementById('journal-empty');

    function apply(tag: string, pushUrl: boolean) {
      buttons.forEach((b) => {
        const isActive = b.dataset.tag === tag;
        b.setAttribute('aria-pressed', String(isActive));
        b.classList.toggle('bg-text-primary', isActive);
        b.classList.toggle('text-surface-main', isActive);
        b.classList.toggle('text-text-secondary', !isActive);
      });

      let visible = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split(' ').filter(Boolean);
        const shown = tag === ALL_FILTER || tags.includes(tag);
        card.style.display = shown ? '' : 'none';
        if (shown) visible++;
      });

      empty?.classList.toggle('hidden', visible > 0);

      if (pushUrl) {
        const url = new URL(window.location.href);
        if (tag === ALL_FILTER) url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        history.replaceState(null, '', url);
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.tag || ALL_FILTER, true));
    });

    apply(getActiveFilter(window.location.search, 'tag'), false);
  </script>
</BaseLayout>
