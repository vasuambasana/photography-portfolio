---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/portfolio/GalleryGrid.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photos');
const sortedPhotos = allPhotos.sort((a, b) => a.data.order - b.data.order);

// Extract unique categories for filter
const categories = [...new Set(allPhotos.map((p) => p.data.category))].sort();
---

<BaseLayout
  title="Gallery"
  description="Browse the complete photography gallery by category."
>
  <section class="pt-4 pb-section" aria-labelledby="gallery-heading">
    <div class="section-container">
      <!-- Header -->
      <div class="mb-6 md:mb-8">
        <h1 id="gallery-heading" class="font-display text-display-md text-text-primary mb-2">
          Gallery
        </h1>
        <p class="text-body-md text-text-secondary max-w-prose">
          A curated collection of photographs exploring architecture, nature, and street life.
        </p>
      </div>

      <!-- Category filter -->
      <nav class="mb-6 md:mb-8" aria-label="Filter photos by category">
        <ul class="flex flex-wrap items-center gap-2">
          <li>
            <button
              data-filter="all"
              class="filter-btn active px-3 py-1.5 text-xs font-mono uppercase tracking-widest rounded-full border border-subtle transition-colors duration-200 bg-text-primary text-surface-main"
              aria-pressed="true"
            >
              All
            </button>
          </li>
          {categories.map((cat) => (
            <li>
              <button
                data-filter={cat}
                class="filter-btn px-3 py-1.5 text-xs font-mono uppercase tracking-widest rounded-full border border-subtle text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-colors duration-200"
                aria-pressed="false"
              >
                {cat}
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Photos grid -->
      <GalleryGrid>
        {sortedPhotos.map((photo) => (
          <div data-category={photo.data.category} class="group relative overflow-hidden rounded-card bg-surface-overlay mb-3 md:mb-4 break-inside-avoid">
            <a href={`/photo/${photo.slug}`} class="block w-full">
              <img
                src={typeof photo.data.image === 'string' ? photo.data.image : photo.data.image.src}
                alt={photo.data.alt}
                loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
                <span class="p-4 text-white text-sm font-body font-medium">{photo.data.title}</span>
              </div>
            </a>
          </div>
        ))}
      </GalleryGrid>
    </div>
  </section>

  <script>
    function initFilters() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const items = document.querySelectorAll<HTMLElement>('[data-category]');

      if (!buttons.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          // Update active states
          buttons.forEach((b) => {
            const isActive = b === btn;
            b.setAttribute('aria-pressed', String(isActive));
            if (isActive) {
              b.classList.add('bg-text-primary', 'text-surface-main');
              b.classList.remove('text-text-secondary');
            } else {
              b.classList.remove('bg-text-primary', 'text-surface-main');
              b.classList.add('text-text-secondary');
            }
          });

          // Filter items
          items.forEach((item) => {
            const a = item.querySelector('a');
            if (a) {
              const url = new URL(a.href, window.location.origin);
              url.searchParams.set('filter', filter);
              a.href = url.toString();
            }

            if (filter === 'all' || item.dataset.category === filter) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      // Run once on load to set initial URLs if default filter is active
      const activeBtn = document.querySelector('.filter-btn.active');
      if (activeBtn) {
        // @ts-ignore
        activeBtn.click();
      }
    }

    initFilters();
    document.addEventListener('astro:after-swap', initFilters);
  </script>
</BaseLayout>
