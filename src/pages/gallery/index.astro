---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/portfolio/GalleryGrid.astro';
import PhotoCard from '../../components/portfolio/PhotoCard.astro';
import { getCollection } from 'astro:content';
import { sortPhotos } from '../../utils/photos';

const allPhotos = await getCollection('photos');
const sortedPhotos = sortPhotos(allPhotos);

const categories = [...new Set(allPhotos.map((p) => p.data.category))].sort();

// A generic "browse the gallery" line competes with every other gallery on the web.
// The real counts and categories are what make the snippet specific.
const description = `${sortedPhotos.length} photographs by Vasu Ambasana - ${categories.join(', ')} - each one listed with the camera and settings it was made on.`;

// The most recent photograph stands in for the gallery on social cards.
const social = await getImage({ src: sortedPhotos[0].data.image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
---

<BaseLayout
  title="Gallery"
  description={description}
  ogImage={social.src}
  ogImageSize={{ width: 1200, height: 630 }}
  ogImageAlt={sortedPhotos[0].data.alt}
  schema="CollectionPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Gallery', path: '/gallery' },
  ]}
  schemaProps={{
    mainEntity: {
      '@type': 'ImageGallery',
      name: 'Photography Gallery',
      numberOfItems: sortedPhotos.length,
      about: categories,
    },
  }}
>
  <section class="pt-2 pb-12" aria-labelledby="gallery-heading">
    <div class="section-container">
      <!-- Integrated Header & Filter Bar -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 pb-4 border-b border-subtle">
        <div>
          <div class="flex items-center gap-3 mb-1">
            <h1 id="gallery-heading" class="font-display text-display-md text-text-primary">
              Gallery
            </h1>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-surface-overlay text-text-secondary border border-subtle">
              {sortedPhotos.length} Photographs
            </span>
          </div>
          <p class="text-body-sm text-text-secondary max-w-prose">
            A visual archive of architecture, nature, street, and twilight captures.
          </p>
        </div>

        <div class="flex flex-col items-start md:items-end gap-2.5">
        <!-- Category filter pills -->
        <nav aria-label="Filter photos by category">
          <ul class="flex flex-wrap items-center gap-1.5">
            <li>
              <button
                data-filter="all"
                class="filter-btn px-3.5 py-1 text-xs font-mono uppercase tracking-wider rounded-full border border-subtle transition-all duration-200 text-text-secondary hover:text-text-primary hover:bg-surface-overlay"
                aria-pressed="false"
              >
                All
              </button>
            </li>
            {categories.map((cat) => (
              <li>
                <button
                  data-filter={cat}
                  class="filter-btn px-3.5 py-1 text-xs font-mono uppercase tracking-wider rounded-full border border-subtle text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-all duration-200"
                  aria-pressed="false"
                >
                  {cat}
                </button>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Order: newest first, or by how much light there was -->
        <div class="flex items-center gap-2" role="group" aria-label="Order photos">
          <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary">Order</span>
          <button
            data-sort="newest"
            class="sort-btn px-3 py-1 text-[11px] font-mono uppercase tracking-wider rounded-full border border-subtle text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-all duration-200"
            aria-pressed="true"
          >
            Newest
          </button>
          <button
            data-sort="light"
            class="sort-btn px-3 py-1 text-[11px] font-mono uppercase tracking-wider rounded-full border border-subtle text-text-secondary hover:text-text-primary hover:bg-surface-overlay transition-all duration-200"
            aria-pressed="false"
            title="Sorted by exposure value, from the longest night exposure to the brightest daylight"
          >
            Darkest first
          </button>
        </div>
        </div>
      </div>

      <!-- Photos grid -->
      <GalleryGrid>
        {sortedPhotos.map((photo) => (
          <PhotoCard photo={photo} showCategory />
        ))}
      </GalleryGrid>

      <p id="gallery-empty" class="hidden text-center py-16 text-text-secondary text-body-md">
        No photographs in this category yet.
      </p>
    </div>
  </section>

  <script>
    import { ALL_FILTER, getActiveFilter, matchesFilter, withFilter } from '../../utils/filter';

    type Sort = 'newest' | 'light';
    const SORT_PARAM = 'sort';

    const grid = document.getElementById('portfolio-grid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>(':scope > [data-category]')];
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const sortButtons = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    const empty = document.getElementById('gallery-empty');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let filter = getActiveFilter();
    // The order is a way of looking at the gallery, not a filter, so only this page reads it.
    let sort: Sort = new URL(location.href).searchParams.get(SORT_PARAM) === 'light' ? 'light' : 'newest';

    // The server renders newest first. "Darkest first" orders by exposure value: the
    // longest night exposures at the top, the brightest daylight at the bottom, and
    // photos that recorded no settings after all of them.
    const byLight = [...cards].sort((a, b) => {
      const ea = a.dataset.ev ? Number(a.dataset.ev) : null;
      const eb = b.dataset.ev ? Number(b.dataset.ev) : null;
      if (ea === null || eb === null) return ea === null ? (eb === null ? 0 : 1) : -1;
      return ea - eb;
    });

    function setPressed(buttons: NodeListOf<HTMLButtonElement>, key: 'filter' | 'sort', value: string) {
      buttons.forEach((b) => {
        const active = b.dataset[key] === value;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-text-primary', active);
        b.classList.toggle('text-surface-main', active);
        b.classList.toggle('shadow-sm', active);
        b.classList.toggle('text-text-secondary', !active);
      });
    }

    function render() {
      setPressed(filterButtons, 'filter', filter);
      setPressed(sortButtons, 'sort', sort);

      for (const card of sort === 'light' ? byLight : cards) grid.appendChild(card);

      let visible = 0;
      cards.forEach((card) => {
        const shown = matchesFilter(card.dataset.category, filter);
        card.style.display = shown ? '' : 'none';
        if (shown) visible++;
        const link = card.querySelector<HTMLAnchorElement>('[data-photo-link]');
        if (link) link.href = withFilter(link.pathname, filter);
      });
      empty?.classList.toggle('hidden', visible > 0);
    }

    function syncUrl() {
      const url = new URL(location.href);
      if (filter === ALL_FILTER) url.searchParams.delete('filter');
      else url.searchParams.set('filter', filter);
      if (sort === 'light') url.searchParams.set(SORT_PARAM, 'light');
      else url.searchParams.delete(SORT_PARAM);
      history.replaceState(null, '', url);
    }

    const onScreen = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.height > 0 && r.bottom > 0 && r.top < innerHeight;
    };

    // Cards glide to their new places. Only the ones on screen before or after are
    // animated; naming all 127 would ask a phone to capture every photograph at once.
    function update() {
      syncUrl();
      // Re-appending cards would otherwise replay their load-in fade.
      grid.classList.add('stagger-done');
      if (reducedMotion || !document.startViewTransition) {
        render();
        return;
      }

      const named = new Set<HTMLElement>();
      const nameOnScreen = () =>
        cards.forEach((card) => {
          if (card.style.display !== 'none' && onScreen(card)) {
            card.style.viewTransitionName = `card-${card.dataset.slug}`;
            (card.style as CSSStyleDeclaration & { viewTransitionClass?: string }).viewTransitionClass = 'gallery-card';
            named.add(card);
          }
        });

      nameOnScreen();
      const vt = document.startViewTransition(() => {
        render();
        nameOnScreen();
      });
      vt.finished.finally(() => named.forEach((card) => (card.style.viewTransitionName = '')));
    }

    filterButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        filter = btn.dataset.filter || ALL_FILTER;
        update();
      })
    );
    sortButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const next = btn.dataset.sort === 'light' ? 'light' : 'newest';
        if (next === sort) return;
        sort = next;
        update();
      })
    );

    render();
  </script>
</BaseLayout>
