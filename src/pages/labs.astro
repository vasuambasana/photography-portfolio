---
import BaseLayout from '../layouts/BaseLayout.astro';

// Everything that is still an experiment, and where to find it. Keep this list in step
// with the design-system skill's motion table: an experiment that graduates to the
// stable site comes off this page.
const experiments = [
  {
    title: 'Colour match',
    fresh: true,
    where: 'Uses your camera, on your device',
    about:
      'Point your phone at anything, a jumper, a wall, the sky out of the window, and the archive answers with the photograph whose colours are closest, changing as you move. Or choose a picture, or pick a colour. Nothing is recorded or sent.',
    href: '/match',
    cta: 'Show it a colour',
  },
  {
    title: 'Postcards',
    fresh: true,
    where: 'On every photograph page, next to the settings card',
    about:
      "Any photograph as a postcard: the whole photograph on the front, your note on the back. The stamp is printed in the photograph's own colour with its shutter speed for a value, and the postmark has the day it was made, and the place when I know it. Send both sides as one picture.",
    href: '/photo/highway-to-the-cosmos',
    cta: 'Write one',
  },
  {
    title: 'The page wears the photograph',
    fresh: true,
    where: 'On every photograph page',
    about:
      'Each photograph page takes its colour from the photograph: its links, its highlights, a faint tint to the page, all measured from the picture and checked so the text stays readable. Step from one photograph to the next and watch it change.',
    href: '/photo/crimson-ascent',
    cta: 'See one',
  },
  {
    title: 'Your eye',
    fresh: true,
    where: 'In the gallery, once you have opened six photographs',
    about:
      'What you have been drawn to, from the photographs you opened: how many were made after dark, how long your lenses run, your colour. Worked out in your browser, with a card to share if you like.',
    href: '/gallery#your-eye',
    cta: 'See your eye',
  },
  {
    title: 'Phone or camera?',
    fresh: true,
    where: 'A game with no end',
    about:
      'Most of this archive was made on phones, the rest on a camera with lenses. One photograph at a time: which was it? The answer is the make the file records.',
    href: '/play#phone',
    cta: 'Play',
  },
  {
    title: 'Guess the exposure',
    where: 'A new photograph every day',
    about:
      'One frame from the archive and three dials: shutter speed, ISO and focal length. Guess what it was shot at, then see the real settings from the file.',
    href: '/play',
    cta: 'Play today',
  },
  {
    title: 'Loupe and viewfinder',
    where: 'On every photograph page',
    about:
      "Press and hold a photograph to look closer under a loupe. Press V for the camera's view: framing guides, the settings, a histogram of the file, and a spot meter that reads in stops wherever you point.",
    href: '/photo/quiet-sentinel',
    cta: 'Try it on a photograph',
  },
  {
    title: 'Colour rhymes',
    where: 'On every photograph page, and in the gallery',
    about:
      'Each photograph points to another, from a different year, with the same colours in it. In the gallery, pick any colour the archive holds and every photograph with it comes forward.',
    href: '/gallery',
    cta: 'Pick a colour',
  },
  {
    title: 'What you have seen',
    where: 'In the gallery',
    about:
      'Your browser remembers which photographs you have opened and which are new since your last visit. Nothing is sent anywhere.',
    href: '/gallery',
    cta: 'See your progress',
  },
  {
    title: 'After dark',
    where: 'On the home page',
    about:
      'If it is evening where you are, the home page leads with photographs made in low light. On a phone, shake it for another photograph.',
    href: '/',
    cta: 'Go home',
  },
];
---

<BaseLayout
  title="Labs"
  description="Things I am still trying out on this site. Switch them on to see what is coming; the rest of the site stays as it is."
  noindex={true}
>
  <section class="section-container max-w-4xl mx-auto pt-6 pb-16">
    <header class="mb-10">
      <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-secondary mb-3">Labs</p>
      <h1 class="font-display text-display-lg text-text-primary mb-4">Things I am still trying out</h1>
      <p class="text-body-lg text-text-secondary max-w-prose">
        The site you usually see stays exactly as it is. Switch Labs on and these experiments
        appear on top of it, in this browser only. Some will become part of the site; some will
        quietly go away. Switch it off any time.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <button
          type="button"
          role="switch"
          aria-checked="false"
          data-labs-toggle
          class="labs-switch group inline-flex items-center gap-3 rounded-full border border-subtle bg-surface-card pl-2 pr-5 py-2 text-body-sm text-text-primary shadow-sm hover:bg-surface-overlay transition-colors"
        >
          <span class="labs-switch-track relative inline-block h-6 w-11 rounded-full bg-surface-overlay border border-subtle transition-colors">
            <span class="labs-switch-thumb absolute top-0.5 left-0.5 h-[18px] w-[18px] rounded-full bg-text-secondary transition-transform"></span>
          </span>
          <span><span class="labs-only">Labs is on</span><span class="stable-only">Labs is off</span></span>
        </button>
        <button
          type="button"
          data-forget-seen
          class="labs-only text-body-sm text-text-secondary hover:text-text-primary underline decoration-border-subtle underline-offset-4"
        >
          Forget what I have seen
        </button>
      </div>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {experiments.map((x) => (
        <li class="rounded-card border border-subtle bg-surface-card p-6 flex flex-col">
          <p class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.15em] text-text-secondary mb-2">
            {x.fresh && <span class="rounded-full bg-text-primary text-surface-main px-2 py-0.5 tracking-[0.12em]">New</span>}
            <span>{x.where}</span>
          </p>
          <h2 class="font-display text-display-md text-text-primary mb-2">{x.title}</h2>
          <p class="text-body-sm text-text-secondary leading-relaxed flex-1">{x.about}</p>
          <a
            href={x.href}
            class="labs-only mt-4 self-start text-body-sm text-text-accent hover:opacity-80 no-underline"
          >
            {x.cta} &rarr;
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import { labsOn } from '../scripts/labs';
    import { forgetSeen } from '../scripts/seen';

    document.querySelectorAll('[data-labs-toggle]').forEach((b) => b.setAttribute('aria-checked', String(labsOn())));
    document.querySelector('[data-forget-seen]')?.addEventListener('click', (e) => {
      forgetSeen();
      (e.currentTarget as HTMLButtonElement).textContent = 'Forgotten';
    });
  </script>
</BaseLayout>
