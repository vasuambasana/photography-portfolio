---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  description="Say hello or ask a question."
>
  <section class="py-section" aria-labelledby="contact-heading">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Info column -->
        <div class="lg:col-span-2">
          <p class="meta-text mb-6">Contact</p>

          <h1 id="contact-heading" class="font-display text-display-xl text-text-primary mb-6">
            Say Hello
          </h1>

          <p class="text-body-lg text-text-secondary mb-8">
            Whether you want to discuss photography, talk about a location, or simply have a question - I'd love to hear from you.
          </p>

          <!-- Direct email -->
          <div class="space-y-4">
            <div>
              <h2 class="meta-text mb-2">Email Directly</h2>
              <a
                href="mailto:ambasana.vasu@gmail.com"
                class="text-text-accent text-body-md font-mono hover:opacity-80 transition-opacity"
              >
                ambasana.vasu@gmail.com
              </a>
            </div>

            <div>
              <h2 class="meta-text mb-2">Social</h2>
              <a
                href="https://instagram.com/vasu_ambasana"
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-accent text-body-md font-mono hover:opacity-80 transition-opacity"
              >
                @vasu_ambasana
              </a>
            </div>

            <div>
              <h2 class="meta-text mb-2">Response Time</h2>
              <p class="text-text-secondary text-body-sm">
                I typically reply within a day or two.
              </p>
            </div>
          </div>
        </div>

        <!-- Form column -->
        <div class="lg:col-span-3">
          <ContactForm contactEmail="ambasana.vasu@gmail.com" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
